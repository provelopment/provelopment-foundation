{
  "site": {
    "url": "https://foundation-template.provelopment.com",
    "name": "Provelopment Foundation",
    "tagline": "An open-source website template you can own",
    "description": "This website is a working deployment of the Provelopment Foundation template: the same public code, downloadable and deployable by anyone. It is the template's own reference site, not a client website.",
    "assets": {
      "favicon": "https://foundation-template.provelopment.com/spokes/foundation/assets/favicon.svg"
    }
  },
  "i18n": {
    "defaultLocale": "en-001",
    "locales": [
      {
        "code": "en-001",
        "label": "English",
        "englishLabel": "English"
      },
      {
        "code": "de-de",
        "label": "Deutsch",
        "description": "Diese Website ist eine laufende Installation der Open-Source-Vorlage Provelopment Foundation: derselbe öffentliche Code, den jeder herunterladen und selbst einsetzen kann. Sie ist die Referenzseite der Vorlage, nicht die Website eines Kunden."
      }
    ]
  },
  "sites": [
    {
      "code": "main",
      "label": "Global"
    }
  ],
  "defaultSite": "main",
  "contact": {
    "email": "hello@example.com"
  },
  "socialLinks": [],
  "navigation": [
    {
      "label": "Home",
      "href": "/",
      "iconOpen": "icon-home.svg",
      "iconClosed": "icon-home.svg"
    },
    {
      "label": "About",
      "href": "/about",
      "iconOpen": "icon-about.svg",
      "iconClosed": "icon-about.svg"
    }
  ],
  "footerNavigation": {
    "items": [
      {
        "label": "Germany",
        "href": "https://foundation-template-germany.provelopment.com/"
      }
    ]
  },
  "features": {
    "analytics": {
      "provider": "none"
    },
    "maps": {
      "provider": "none"
    },
    "booking": {
      "provider": "none"
    },
    "contact": {
      "provider": "stub"
    }
  },
  "ui": {
    "density": "comfortable",
    "content": {
      "width": "standard"
    },
    "theme": {
      "mode": "system",
      "radius": "medium"
    },
    "layoutSwitcher": {
      "enabled": true,
      "default": "sidebar"
    }
  },
  "communication": {
    "contactForms": {
      "main": {
        "formRef": "foundation-contact",
        "enabled": true,
        "mode": "simple",
        "transport": "offline",
        "placement": {
          "page": "contact"
        },
        "authorizationRefs": [
          "foundation-web",
          "foundation-inspection"
        ]
      }
    }
  }
}
