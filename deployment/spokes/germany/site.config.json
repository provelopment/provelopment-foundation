{
  "site": {
    "url": "https://foundation-template-germany.provelopment.com",
    "name": "Provelopment Foundation",
    "tagline": "An open-source website template you can own",
    "description": "This website is a working deployment of the Provelopment Foundation template: the same public code, downloadable and deployable by anyone. It is the template's own reference site, not a client website.",
    "assets": {
      "favicon": "https://foundation-template-germany.provelopment.com/spokes/germany/assets/favicon.svg"
    }
  },
  "i18n": {
    "defaultLocale": "en-001",
    "locales": [
      {
        "code": "en-001",
        "label": "English",
        "englishLabel": "English"
      },
      {
        "code": "de-de",
        "label": "Deutsch",
        "description": "Diese Website ist eine laufende Installation der Open-Source-Vorlage Provelopment Foundation: derselbe öffentliche Code, den jeder herunterladen und selbst einsetzen kann. Sie ist die Referenzseite der Vorlage, nicht die Website eines Kunden."
      }
    ]
  },
  "sites": [
    {
      "code": "main",
      "label": "Germany",
      "locales": [
        "de-de",
        "en-001"
      ],
      "defaultLocale": "de-de"
    }
  ],
  "defaultSite": "main",
  "contact": {
    "email": "hello@example.com"
  },
  "business": {
    "regions": {
      "berlin": {
        "timezone": "Europe/Berlin",
        "name": "Berlin",
        "label": "Berlin",
        "address": {
          "street": "Example Street 1",
          "city": "Berlin",
          "country": "Germany"
        },
        "hours": {}
      },
      "frankfurt": {
        "timezone": "Europe/Berlin",
        "name": "Frankfurt",
        "label": "Frankfurt",
        "address": {
          "street": "Example Street 1",
          "city": "Frankfurt",
          "country": "Germany"
        },
        "hours": {}
      }
    },
    "pages": [
      { "site": "main", "locale": "de-de", "region": "berlin" },
      { "site": "main", "locale": "en-001", "region": "berlin" },
      { "site": "main", "locale": "de-de", "region": "frankfurt" },
      { "site": "main", "locale": "en-001", "region": "frankfurt" }
    ]
  },
  "socialLinks": [],
  "navigation": [
    {
      "label": "Home",
      "href": "/",
      "iconOpen": "icon-home.svg",
      "iconClosed": "icon-home.svg"
    },
    {
      "label": "About",
      "href": "/about",
      "iconOpen": "icon-about.svg",
      "iconClosed": "icon-about.svg"
    }
  ],
  "footerNavigation": {
    "items": [
      {
        "label": "Global",
