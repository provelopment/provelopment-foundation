      "provider": "none"
    },
    "maps": {
      "provider": "none"
    },
    "booking": {
      "provider": "none"
    },
    "contact": {
      "provider": "stub"
    }
  },
  "ui": {
    "density": "comfortable",
    "content": {
      "width": "standard"
    },
    "theme": {
      "mode": "system",
      "radius": "medium"
    },
    "layoutSwitcher": {
      "enabled": true,
      "default": "sidebar"
    }
  }
